{
  "name": "@drawmotive/editor",
  "version": "0.0.0-development",
  "description": "Embeddable DrawMotive visual diagram editor",
  "private": true,
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "worker": "./src/platform/worker.js",
      "browser": "./src/platform/browser.js",
      "node": "./src/platform/node.js",
      "default": "./src/platform/browser.js"
    },
    "./browser": {
      "types": "./src/index.d.ts",
      "default": "./src/platform/browser.js"
    },
    "./node": {
      "types": "./src/index.d.ts",
      "default": "./src/platform/node.js"
    },
    "./worker": {
      "types": "./src/index.d.ts",
      "default": "./src/platform/worker.js"
    }
  },
  "files": [
    "src",
    "generated/wasm",
    "generated/wasm-manifest.json"
  ],
  "scripts": {
    "build": "node --check src/index.js && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drawmotive/drawmotive.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@drawmotive/textgraph": "0.0.0-development"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
