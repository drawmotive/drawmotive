{
  "name": "@drawmotive/editor",
  "version": "0.3.1",
  "description": "Embed the DrawMotive visual diagram editor in any browser application.",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "default": "./src/core.js"
    },
    "./react": {
      "types": "./src/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./dist/editor-ui.css"
  },
  "files": [
    "src",
    "dist",
    "generated/editor",
    "generated/editor-manifest.json",
    "scripts/copy-assets.mjs",
    "scripts/verify-assets.mjs",
    "examples",
    "licenses",
    "scripts/audit-package.mjs"
  ],
  "scripts": {
    "build": "node --check src/index.js && tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser": "playwright test",
    "prepack": "node .release/check.cjs --ready && npm test && npm run build && npm run audit:package",
    "release:check": "node .release/check.cjs --ready",
    "assets:verify": "node scripts/verify-assets.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "test:release": "node --test --test-concurrency=1 test/npm-release.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drawmotive/drawmotive.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^30.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "diagram",
    "editor",
    "flowchart",
    "textgraph",
    "browser",
    "webassembly"
  ],
  "homepage": "https://textgraph.dev/editor/",
  "bugs": {
    "url": "https://github.com/drawmotive/drawmotive/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "bin": {
    "drawmotive-copy-assets": "./scripts/copy-assets.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "dexie": "4.4.7"
  }
}
